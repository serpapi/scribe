{
  "name": "scribe",
  "version": "1.0.0",
  "description": "Convert a YouTube video into an eBook for easy reading.",
  "main": "src/cli.js",
  "scripts": {
    "test": "node src/cli.js 'https://youtu.be/gzF7aHxk4Y4' -format epub -lang en-GB",
    "update-langs": "curl --output './src/serpapi-transcript-languages.json' 'https://serpapi.com/youtube-video-transcript-languages.json'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serpapi/scribe.git"
  },
  "keywords": [
    "youtube",
    "serpapi",
    "video",
    "ebook",
    "epub"
  ],
  "license": "MIT",
  "author": "SerpApi <contact@serpapi.com> (https://serpapi.com/)",
  "type": "module",
  "bugs": {
    "url": "https://github.com/serpapi/scribe/issues"
  },
  "bin": {
    "scribe": "src/cli.js",
    "scribe-web": "src/web.js"
  },
  "homepage": "https://github.com/serpapi/scribe#readme",
  "dependencies": {
    "express": "5.3.0",
    "serve-static": "2.2.1"
  }
}
